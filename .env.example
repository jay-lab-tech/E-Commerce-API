NODE_ENV=development
PORT=3001

# Local PostgreSQL. The Auth Service owns identity; this service stores only userId references.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ecommerce_api?schema=public

# Redis is used for cache, rate limits, and BullMQ in later phases.
REDIS_URL=redis://127.0.0.1:6379

# Must match the Auth Service secret in local development.
JWT_ACCESS_SECRET=replace-with-a-local-secret-at-least-32-characters
